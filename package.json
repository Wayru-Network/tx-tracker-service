{
  "name": "tx-tracker-server",
  "version": "1.0.0",
  "description": "Blockchain transactions tracker for Wayru Network Ecosystem",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && npm run copy-sql && eslint .",
    "copy-sql": "mkdir -p dist/database && cp src/database/*.sql dist/database/ 2>/dev/null || true",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@koa/router": "13.1.0",
    "@metaplex-foundation/umi": "1.1.1",
    "@solana/web3.js": "1.98.0",
    "dotenv": "16.4.7",
    "koa": "2.15.3",
    "koa-bodyparser": "4.4.1",
    "koa-logger": "3.2.1",
    "koa-router": "12.0.1",
    "node-cron": "3.0.3",
    "pg": "8.14.1"
  },
  "devDependencies": {
    "@types/koa": "2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-logger": "^3.1.5",
    "@types/koa-router": "^7.4.9",
    "@types/node": "^22.10.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "nodemon": "^3.1.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.3"
  }
}